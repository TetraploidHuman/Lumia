<idea-plugin>
  <id>org.lumi.idea</id>
  <name>Lumi</name>
  <version>0.3.5</version>
  <vendor>Lumi</vendor>
  <description><![CDATA[
    Lumi language support: syntax highlighting, Check / Build &amp; Run configurations,
    New Project / New Lumi Project (Lumi.toml + src/main.lm), New File, live templates,
    and LSP (diagnostics, completion, hover, go-to-definition, formatting, outline)
    via <code>lumi lsp</code>.
    <br/>Build the compiler: <code>source scripts/env.sh &amp;&amp; cargo build -p lumi --release</code>
  ]]></description>

  <idea-version since-build="262" until-build="262.*"/>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType
        name="Lumi"
        implementationClass="org.lumi.idea.LumiFileType"
        fieldName="INSTANCE"
        language="Lumi"
        extensions="lm"/>
    <lang.parserDefinition
        language="Lumi"
        implementationClass="org.lumi.idea.LumiParserDefinition"/>
    <lang.syntaxHighlighterFactory
        language="Lumi"
        implementationClass="org.lumi.idea.LumiSyntaxHighlighterFactory"/>
    <lang.braceMatcher language="Lumi" implementationClass="org.lumi.idea.LumiBraceMatcher"/>
    <lang.quoteHandler language="Lumi" implementationClass="org.lumi.idea.LumiQuoteHandler"/>
    <lang.lineIndentProvider language="Lumi" implementationClass="org.lumi.idea.LumiLineIndentProvider"/>
    <enterHandlerDelegate implementation="org.lumi.idea.LumiEnterBetweenBracesHandler"/>
    <lang.LanguageCodeStyleSettingsProvider
        implementation="org.lumi.idea.LumiLanguageCodeStyleSettingsProvider"/>

    <internalFileTemplate name="Lumi File"/>
    <defaultLiveTemplates file="/liveTemplates/Lumi.xml"/>
    <liveTemplateContext
        contextId="Lumi"
        implementation="org.lumi.idea.LumiContextType"/>

    <applicationConfigurable
        parentId="language"
        instance="org.lumi.idea.LumiSettingsConfigurable"
        id="org.lumi.idea.settings"
        displayName="Lumi"/>
    <applicationService serviceImplementation="org.lumi.idea.LumiSettings"/>

    <platform.lsp.integrationProvider
        implementation="org.lumi.idea.LumiLspServerSupportProvider"/>
    <postStartupActivity implementation="org.lumi.idea.LumiProjectActivity"/>

    <newProjectWizard.languageGenerator implementation="org.lumi.idea.LumiLanguageProjectWizard"/>

    <configurationType implementation="org.lumi.idea.LumiRunConfigurationType"/>
    <runConfigurationProducer implementation="org.lumi.idea.LumiCheckConfigurationProducer"/>
    <runConfigurationProducer implementation="org.lumi.idea.LumiBuildConfigurationProducer"/>
  </extensions>

  <actions>
    <action
        id="Lumi.CreateProject"
        class="org.lumi.idea.LumiCreateProjectAction"
        text="New Lumi Project…"
        description="Create a Lumi package (Lumi.toml + src/main.lm) and open it"
        icon="org.lumi.idea.LumiIcons.FILE">
      <add-to-group group-id="WelcomeScreen.QuickStart" anchor="last"/>
      <add-to-group group-id="FileMenu" anchor="before" relative-to-action="Exit"/>
    </action>
    <action
        id="Lumi.InitProject"
        class="org.lumi.idea.LumiInitProjectAction"
        text="Lumi Project"
        description="Create Lumi.toml and src/main.lm in the project root"
        icon="org.lumi.idea.LumiIcons.FILE">
      <add-to-group group-id="NewGroup" anchor="before" relative-to-action="Kotlin.NewScript"/>
    </action>
    <action
        id="Lumi.NewFile"
        class="org.lumi.idea.LumiNewFileAction"
        text="Lumi File"
        description="Create a new Lumi (.lm) file"
        icon="org.lumi.idea.LumiIcons.FILE">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="Lumi.InitProject"/>
    </action>
    <group id="Lumi.Menu" text="Lumi" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action
          id="Lumi.InitProjectTools"
          class="org.lumi.idea.LumiInitProjectAction"
          text="New Lumi Project"
          description="Create Lumi.toml and src/main.lm in the project root"/>
      <action
          id="Lumi.CheckFile"
          class="org.lumi.idea.LumiCheckFileAction"
          text="Check File"
          description="Run lumi check on the current file"/>
      <action
          id="Lumi.BuildFile"
          class="org.lumi.idea.LumiBuildFileAction"
          text="Build File"
          description="Run lumi build on the current file"/>
      <action
          id="Lumi.FormatFile"
          class="org.lumi.idea.LumiFormatFileAction"
          text="Format File"
          description="Format the current Lumi file"/>
      <action
          id="Lumi.RestartLsp"
          class="org.lumi.idea.LumiRestartLspAction"
          text="Restart Language Server"
          description="Restart lumi lsp for this project"/>
    </group>
  </actions>
</idea-plugin>
