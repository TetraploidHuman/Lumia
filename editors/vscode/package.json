{
  "name": "lumi",
  "displayName": "Lumi",
  "description": "Lumi language support — syntax highlight, LSP, run/build",
  "version": "0.3.9",
  "publisher": "lumi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lumi",
    "workspaceContains:Cargo.toml",
    "workspaceContains:Lumi.toml",
    "workspaceContains:lumi/*.lm",
    "workspaceContains:examples/*.lm",
    "onCommand:lumi.run",
    "onCommand:lumi.buildRun",
    "onCommand:lumi.checkFile",
    "onCommand:lumi.restartServer"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lumi",
        "aliases": [
          "Lumi",
          "lumi"
        ],
        "extensions": [
          ".lm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lumi",
        "scopeName": "source.lumi",
        "path": "./syntaxes/lumi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lumi",
        "path": "./snippets/lumi.json"
      }
    ],
    "commands": [
      {
        "command": "lumi.run",
        "title": "Lumi: Run",
        "category": "Lumi",
        "icon": "$(play)",
        "enablement": "resourceExtname == .lm || editorLangId == lumi"
      },
      {
        "command": "lumi.buildRun",
        "title": "Lumi: Build & Run",
        "category": "Lumi",
        "icon": "$(tools)",
        "enablement": "resourceExtname == .lm || editorLangId == lumi"
      },
      {
        "command": "lumi.checkFile",
        "title": "Lumi: Check File",
        "category": "Lumi"
      },
      {
        "command": "lumi.restartServer",
        "title": "Lumi: Restart Language Server",
        "category": "Lumi"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lumi.run",
          "when": "resourceExtname == .lm",
          "group": "navigation@1"
        },
        {
          "command": "lumi.buildRun",
          "when": "resourceExtname == .lm",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "lumi.run",
          "when": "resourceExtname == .lm",
          "group": "lumi@1"
        },
        {
          "command": "lumi.buildRun",
          "when": "resourceExtname == .lm",
          "group": "lumi@2"
        },
        {
          "command": "lumi.checkFile",
          "when": "resourceExtname == .lm",
          "group": "lumi@3"
        }
      ],
      "explorer/context": [
        {
          "command": "lumi.run",
          "when": "resourceExtname == .lm",
          "group": "navigation@10"
        },
        {
          "command": "lumi.buildRun",
          "when": "resourceExtname == .lm",
          "group": "navigation@11"
        }
      ],
      "commandPalette": [
        {
          "command": "lumi.run",
          "when": "resourceExtname == .lm || editorLangId == lumi"
        },
        {
          "command": "lumi.buildRun",
          "when": "resourceExtname == .lm || editorLangId == lumi"
        }
      ]
    },
    "configuration": {
      "title": "Lumi",
      "properties": {
        "lumi.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the lumi binary (or lumi-lsp). Empty = auto-detect ~/.local/lib/lumi/lumi-lsp then PATH."
        },
        "lumi.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Lumi language server."
        }
      }
    },
    "configurationDefaults": {
      "[lumi]": {
        "editor.inlayHints.enabled": "on",
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {},
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
