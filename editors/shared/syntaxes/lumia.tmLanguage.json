{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lumia",
  "scopeName": "source.lumia",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lumia",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lumia",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lumia",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lumia",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.lumia",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lumia",
          "match": "\\b(if|else|match|for|in|break|continue|return|alt|scope|spawn|to)\\b"
        },
        {
          "name": "keyword.declaration.lumia",
          "match": "\\b(module|import|val|var|type|trait|instance|requires|with|effect|foreign|priv|as|pure|fn)\\b"
        },
        {
          "name": "keyword.operator.logical.lumia",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lumia",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lumia",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lumia",
          "match": "(>>|==|!=|<=|>=|->|=>|[+\\-*/%<>=!])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.lumia",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lumia",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
