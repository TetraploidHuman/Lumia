/target
**/*.rs.bk
*.o
*.ll
/hello
/out/
/matmul
.idea/
.vscode/

# Local probe / scratch binaries often built in the repo root (not under target/)
/*
!/.cargo/
!/.github/
!/.gitattributes
!/.gitignore
!/Cargo.lock
!/Cargo.toml
!/README.md
!/LICENSE
!/Todo.md
!/clippy.toml
!/rustfmt.toml
!/crates/
!/docs/
!/editors/
!/examples/
!/extras/
!/scripts/
!/std/
!/tests/

# Editor plugin build artifacts (also covered by nested .gitignore)
editors/**/node_modules/
editors/**/build/
editors/**/*.vsix
editors/idea/.gradle/
editors/idea/.kotlin/
editors/idea/.intellijPlatform/
