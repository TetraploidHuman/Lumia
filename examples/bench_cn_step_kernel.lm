module BenchCnStepKernel

/// Same full step as `bench_cn_step_naive.lm`, via `lumi.linalg` kernels.
import lumi.io.{println}
import lumi.linalg.{zeros, fill, scale, mul, add, gemv, gemvT, addmm, axpy, sub, clamp, l2Normalize, copy, checksum}

val VIS = 16
val PFC = 32
val STEPS = 100000
val LR = 0.05
val CLIP = 10.0
val DECAY = 0.0001
val GAIN = 0.02

val main = {
    var muVis = zeros(VIS)
    var muPfc = zeros(PFC)
    var wVp = zeros(PFC * VIS)
    var enc = zeros(PFC * PFC)
    var pred = zeros(PFC * PFC)
    var drive = zeros(PFC)
    var predBuf = zeros(PFC)
    var err = zeros(PFC)
    var gated = zeros(PFC)
    var gate = zeros(PFC)
    var delta = zeros(PFC)
    var stim = zeros(VIS)
    var u = zeros(VIS)
    var v = zeros(PFC)

    var i = 0
    for i < VIS {
        muVis = muVis.set(i, (0.0 + i) * 0.01)
        i = i + 1
    }
    i = 0
    for i < PFC {
        muPfc = muPfc.set(i, (0.0 + i) * 0.001)
        gate = gate.set(i, 0.5 + (0.0 + i) * 0.01)
        i = i + 1
    }
    i = 0
    for i < PFC {
        var j = 0
        for j < VIS {
            wVp = wVp.set(i * VIS + j, (0.0 + i + j) * 0.001)
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    for i < PFC {
        enc = enc.set(i * PFC + i, 1.0)
        pred = pred.set(i * PFC + i, 1.0)
        i = i + 1
    }

    var t = 0
    for t < STEPS {
        stim = fill(stim, (0.0 + (t % 16)) * 0.001)
        stim = scale(stim, GAIN)
        muVis = add(muVis, muVis, stim)
        muVis = clamp(muVis, 0.0 - CLIP, CLIP)

        drive = gemv(PFC, VIS, wVp, muVis, drive)
        predBuf = gemvT(PFC, PFC, pred, muPfc, predBuf)
        err = sub(err, drive, predBuf)
        gated = mul(gated, err, gate)
        delta = gemvT(PFC, PFC, enc, gated, delta)
        muPfc = axpy(muPfc, LR, delta)
        muPfc = clamp(muPfc, 0.0 - CLIP, CLIP)

        u = copy(u, muVis)
        v = copy(v, gated)
        u = l2Normalize(u, 0.001)
        v = l2Normalize(v, 0.001)
        wVp = scale(wVp, 1.0 - DECAY)
        wVp = addmm(PFC, VIS, wVp, v, u, LR)
        t = t + 1
    }

    println(checksum(muPfc))
    println(checksum(wVp))
    println(checksum(muVis))
}
