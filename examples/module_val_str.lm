module ModuleValStr

import lumi.io.{println}

// Regression: module-level String vals must be typed so GC roots the getter result.
val greeting = "hello"

val main = {
    // Allocate enough to trigger soft GC if greeting were unrooted.
    var i = 0
    var junk = listOf(0)
    for i < 8000 {
        junk = listOf(i, i + 1, i + 2, i + 3)
        i = i + 1
    }
    println(greeting)
    println(junk.len())
}
