module FloatListMap

import lumi.io.{println}

val main = {
    val xs = listOf(1.5, 2.5).map({ x -> x + x })
    println(xs.get(0))
    println(xs.get(0) == 3.0)
    val s = listOf(1.5, 2.5).fold(0.0, { a, b -> a + b })
    println(s == 4.0)
    val ys = listOf(1.5).flatMap({ x -> listOf(x, x + x) })
    println(ys.get(1) == 3.0)
}
