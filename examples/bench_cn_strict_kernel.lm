module BenchCnStrictKernel

/// Strict-PE shape: cluster rates → projectError → nucleus → learnGenerative.
/// Mirrors CogniNucleus defaults (`strict_pe` + `enable_cluster_rates`).
import lumi.io.{println}
import lumi.linalg.{zeros, copy, checksum}
import lumi.cn.{nucleusStep, projectError, clusterRates, learnGenerative}

val SIZE = 32
val FROM = 16
val N_CLUSTERS = 4
val STEPS = 50000
val STATE_LR = 0.1
val LR = 0.05
val PI = 1.0
val MU_CLIP = 10.0
val W_CLIP = 5.0
val W_DECAY = 0.0001
val C_DECAY = 0.9
val C_THR = 0.5

val main = {
    var mu = zeros(SIZE)
    var enc = zeros(SIZE * SIZE)
    var predW = zeros(SIZE * SIZE)
    var bu = zeros(SIZE)
    var td = zeros(SIZE)
    var err = zeros(SIZE)
    var pred = zeros(SIZE)
    var pot = zeros(SIZE)
    var rates = zeros(SIZE)
    var peSrc = zeros(FROM)
    var drive = zeros(SIZE)
    var w = zeros(FROM * SIZE)

    var i = 0
    for i < SIZE {
        mu = mu.set(i, (0.0 + i) * 0.001)
        bu = bu.set(i, (0.0 + i) * 0.01)
        td = td.set(i, (0.0 + i) * 0.005)
        enc = enc.set(i * SIZE + i, 1.0)
        predW = predW.set(i * SIZE + i, 1.0)
        i = i + 1
    }
    i = 0
    for i < FROM {
        peSrc = peSrc.set(i, (0.0 + i) * 0.02)
        i = i + 1
    }
    i = 0
    for i < FROM * SIZE {
        w = w.set(i, (0.0 + (i % 17)) * 0.001)
        i = i + 1
    }

    var t = 0
    for t < STEPS {
        bu = bu.set(t % SIZE, (0.0 + (t % 32)) * 0.001)
        rates = clusterRates(pot, bu, rates, SIZE, N_CLUSTERS, C_DECAY, C_THR)
        drive = projectError(FROM, SIZE, w, peSrc, drive, MU_CLIP)
        // Mix projected PE into rate-coded bottom-up (strict-PE-ish drive).
        var k = 0
        for k < SIZE {
            bu = bu.set(k, rates.get(k) + drive.get(k) * 0.1)
            k = k + 1
        }
        mu = nucleusStep(mu, enc, predW, bu, td, err, pred, SIZE, STATE_LR, PI, MU_CLIP)
        td = copy(td, pred)
        enc = learnGenerative(enc, predW, mu, err, SIZE, LR, W_CLIP, W_DECAY, PI)
        t = t + 1
    }

    println(checksum(mu))
    println(checksum(enc))
    println(checksum(predW))
    println(checksum(rates))
}
