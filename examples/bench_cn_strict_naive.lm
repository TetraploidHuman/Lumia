module BenchCnStrictNaive

/// Same strict-PE workload as `bench_cn_strict_kernel.lm`, via `std.linalg` + loops.
import std.io.{println}
import std.linalg.{
    zeros, copy, checksum, sub, scale, gemv, gemvT, axpy, clamp, addmm
}

val SIZE = 32
val FROM = 16
val N_CLUSTERS = 4
val STEPS = 50000
val STATE_LR = 0.1
val LR = 0.05
val PI = 1.0
val MU_CLIP = 10.0
val W_CLIP = 5.0
val W_DECAY = 0.0001
val C_DECAY = 0.9
val C_THR = 0.5

val main = {
    var mu = zeros(SIZE)
    var enc = zeros(SIZE * SIZE)
    var predW = zeros(SIZE * SIZE)
    var bu = zeros(SIZE)
    var td = zeros(SIZE)
    var err = zeros(SIZE)
    var pred = zeros(SIZE)
    var pot = zeros(SIZE)
    var rates = zeros(SIZE)
    var peSrc = zeros(FROM)
    var drive = zeros(SIZE)
    var w = zeros(FROM * SIZE)
    var scratch = zeros(SIZE)
    var delta = zeros(SIZE)
    var weighted = zeros(SIZE)

    var i = 0
    for i < SIZE {
        mu = mu.set(i, (0.0 + i) * 0.001)
        bu = bu.set(i, (0.0 + i) * 0.01)
        td = td.set(i, (0.0 + i) * 0.005)
        enc = enc.set(i * SIZE + i, 1.0)
        predW = predW.set(i * SIZE + i, 1.0)
        i = i + 1
    }
    i = 0
    for i < FROM {
        peSrc = peSrc.set(i, (0.0 + i) * 0.02)
        i = i + 1
    }
    i = 0
    for i < FROM * SIZE {
        w = w.set(i, (0.0 + (i % 17)) * 0.001)
        i = i + 1
    }

    // Covered length matches Nucleus: (SIZE / N_CLUSTERS) * N_CLUSTERS.
    val covered = (SIZE / N_CLUSTERS) * N_CLUSTERS

    var t = 0
    for t < STEPS {
        bu = bu.set(t % SIZE, (0.0 + (t % 32)) * 0.001)

        // clusterRates
        var c = 0
        for c < covered {
            val potI = pot.get(c) * C_DECAY + bu.get(c)
            pot = pot.set(c, potI)
            val o = potI - C_THR
            val o2 = if o < 0.0 { 0.0 } else { o }
            rates = rates.set(c, o2 * o2)
            c = c + 1
        }
        for c < SIZE {
            rates = rates.set(c, 0.0)
            c = c + 1
        }

        // projectError ≡ x @ W (W from×to) ≡ gemvT
        drive = gemvT(FROM, SIZE, w, peSrc, drive)
        drive = clamp(drive, 0.0 - MU_CLIP, MU_CLIP)

        var k = 0
        for k < SIZE {
            bu = bu.set(k, rates.get(k) + drive.get(k) * 0.1)
            k = k + 1
        }

        // nucleusStep composed
        err = sub(err, bu, td)
        scratch = copy(scratch, err)
        scratch = scale(scratch, PI)
        delta = gemv(SIZE, SIZE, enc, scratch, delta)
        mu = axpy(mu, STATE_LR, delta)
        mu = clamp(mu, 0.0 - MU_CLIP, MU_CLIP)
        pred = gemv(SIZE, SIZE, predW, mu, pred)
        td = copy(td, pred)

        // learnGenerative
        enc = scale(enc, 1.0 - W_DECAY)
        predW = scale(predW, 1.0 - W_DECAY)
        predW = addmm(SIZE, SIZE, predW, mu, err, LR)
        weighted = copy(weighted, err)
        weighted = scale(weighted, PI)
        enc = addmm(SIZE, SIZE, enc, err, weighted, LR * 0.5)
        enc = clamp(enc, 0.0 - W_CLIP, W_CLIP)
        predW = clamp(predW, 0.0 - W_CLIP, W_CLIP)

        t = t + 1
    }

    println(checksum(mu))
    println(checksum(enc))
    println(checksum(predW))
    println(checksum(rates))
}
