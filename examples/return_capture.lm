module ReturnCapture

import std.io.{println}

/// Nested closure returns a captured local via `return` (exercises Core
/// use-collect / local remap on `Op::Return`).
val make(x) = {
    { y ->
        if y == 0 {
            return x
        } else {
            y
        }
    }
}

val main = {
    val f = make(42)
    println(f(0))
    println(f(7))
}
