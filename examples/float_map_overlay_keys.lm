module float_map_overlay_keys
import lumi.io.{println}

/// After HashOrdered promotion, overlay lookup must treat ±0 as the same Float key.
val main = {
    var m = mapOf(
        1.0 to 1, 2.0 to 2, 3.0 to 3, 4.0 to 4, 5.0 to 5,
        6.0 to 6, 7.0 to 7, 8.0 to 8, 9.0 to 9
    )
    // Tenth distinct key → hash; further set builds an overlay.
    m = m.set(0.0, 100)
    m = m.set(-0.0, 200)
    // ±0 are one key: last write wins; count stays stable.
    println(m[0.0] alt -1)
    println(m[-0.0] alt -1)
    println(m.len())
}
