module TraitNum

import lumi.io.{println}

type Vec2 {
    val x
    val y
}

trait Num {
    val add = { self, other -> self }
    val mul = { self, other -> self }
}

instance Num for Vec2 {
    val add = { self, other ->
        Vec2 { x = self.x + other.x, y = self.y + other.y }
    }
    val mul = { self, other ->
        Vec2 { x = self.x * other.x, y = self.y * other.y }
    }
}

val main = {
    val a = Vec2 { x = 2, y = 3 }
    val b = Vec2 { x = 4, y = 5 }
    val s = a + b
    val p = a * b
    println(s.x)
    println(s.y)
    println(p.x)
    println(p.y)
}
