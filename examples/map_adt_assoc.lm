module MapAdtAssoc

import std.io.{println}

/// ADT keys without `instance Hash` stay on the assoc-list path (no hash promote).
type Key {
    val n
}

type Option {
    Some(value)
    None
}

val unwrap_or(opt, d) = {
    opt match {
        None -> d
        Some(v) -> v
    }
}

val main = {
    var m = mapOf()
    var i = 0
    for i < 20 {
        m = m.set(Key { n = i }, i * 2)
        i = i + 1
    }
    println(m.len())
    println(unwrap_or(m.get(Key { n = 0 }), -1))
    println(unwrap_or(m.get(Key { n = 19 }), -1))
    println(m.contains(Key { n = 7 }))
    println(m.contains(Key { n = 99 }))
}
