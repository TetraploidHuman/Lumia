module PolyOption

import std.io.{println}

type Option {
    Some(value)
    None
}

/// Identity at Option[Int] / Option[Float] → `$Option_Int` / `$Option_Float`.
val id = { x -> x }

val main = {
    id(Some(7)) match {
        Some(n) -> println(n)
        None -> println(0)
    }
    id(Some(1.5)) match {
        Some(n) -> println(n)
        None -> println(0.0)
    }
}
