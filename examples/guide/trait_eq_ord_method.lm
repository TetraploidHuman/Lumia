module TraitEqOrdMethod

import std.io.{println}

type Pair {
    val a
    val b
}

trait Eq {
    val eq = { self, other -> false }
}

trait Ord requires Eq {
    val less = { self, other -> false }
}

instance Eq for Pair {
    val eq = { self, other ->
        self.a == other.a
    }
}

instance Ord for Pair {
    val less = { self, other ->
        self.a < other.a
    }
}

/// UFCS `x.eq(y)` / `x.less(y)` → same Binary path as `==` / `<`.
val main = {
    val p = Pair { a = 1, b = 9 }
    val q = Pair { a = 1, b = 0 }
    val r = Pair { a = 2, b = 0 }
    println(p.eq(q))
    println(p.less(r))
    println(r.less(p))
}
