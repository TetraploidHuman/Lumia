module TraitShowDemo

import std.io.{println}

type Point {
    val x
    val y
}

type Box {
    val n
}

trait Show {
    val show = { self -> "?" }
}

instance Show for Point {
    val show = { self -> "Point" }
}

val main = {
    val p = Point { x = 1, y = 2 }
    // Custom Show override.
    println(p)
    // Auto-derived structural Show (no method body).
    println(Box { n = 9 })
}
