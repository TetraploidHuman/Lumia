module BenchMemo

import std.io.{println}

/// Expensive pure work — Release Memo `T_f` (Slots) caches by argument.
/// Static duplicate const calls give the cost model reuse evidence (§7.5.2);
/// the loop then keeps 4 keys hot.
val heavy(n) = {
    (0..n).fold(0, { a, i -> a + i * i })
}

val main = {
    // Const tuples each appear twice → Slots eligibility (planned pre-CSE).
    var acc = heavy(5000) + heavy(5001) + heavy(5002) + heavy(5003)
    acc = acc + heavy(5000) + heavy(5001) + heavy(5002) + heavy(5003)
    var i = 0
    for i < 4000 {
        acc = acc + heavy(5000 + (i % 4))
        i = i + 1
    }
    println(acc)
}
