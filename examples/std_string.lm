module StdString

import lumi.io.{println}
import lumi.string.{trim, toLower, split, join, startsWith}

/// Exercise `lumi.string` Source wrappers (runtime `lumi_str_*` via foreign).
val main = {
    val t = trim("  Hello  ")
    println(t)
    println(toLower(t))
    println(startsWith(t, "He"))
    val parts = split("a-b-c", '-')
    println(join(parts, "/"))
}
