module StdResult

import lumi.io.{println}
import lumi.result.{resultUnwrapOr, resultMap, resultAndThen, mapErr, isOk, isErr}

val dbl(x) = { x + x }
val parseEven(n) = {
    if n % 2 == 0 {
        Ok(n / 2)
    } else {
        Err("odd")
    }
}
val bang(s) = { s.concat("!") }

val main = {
    println(resultUnwrapOr(Ok(42), 0))
    println(resultUnwrapOr(Err("x"), -1))
    resultMap(Ok(1.5), dbl) match {
        Ok(n) -> println(n)
        Err(_) -> println(0.0)
    }
    resultAndThen(Ok(10), parseEven) match {
        Ok(n) -> println(n)
        Err(e) -> println(e)
    }
    resultAndThen(Ok(7), parseEven) match {
        Ok(n) -> println(n)
        Err(e) -> println(e)
    }
    mapErr(Err("boom"), bang) match {
        Ok(n) -> println(n)
        Err(e) -> println(e)
    }
    println(isOk(Ok(1)))
    println(isErr(Err(0)))
}
