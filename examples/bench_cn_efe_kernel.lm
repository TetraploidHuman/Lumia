module BenchCnEfeKernel

/// Same EFE workload as `bench_cn_efe_naive.lm`, via `extras.efe.actionScores`.
import std.io.{println}
import std.linalg.{zeros, copy, checksum}
import extras.efe.{actionScores}

val OBS = 16
val N_ACTIONS = 4
val HORIZON = 2
val STEPS = 50000
val REL = 4
val THREAT = 11
val CELL = 0.25
val PREF = 1.2
val EPI = 0.28
val WALL = 3.2
val GOAL_B = 0.8
val THREAT_G = 2.0
val COMPLEXITY = 0.1

val main = {
    var obs = zeros(OBS)
    var pred = zeros(OBS)
    var scores = zeros(N_ACTIONS)

    obs = obs.set(0, 0.5)
    obs = obs.set(1, 0.5)
    obs = obs.set(4, 0.25)
    obs = obs.set(5, 0.0)
    obs = obs.set(11, 0.1)
    obs = obs.set(12, 0.0)
    obs = obs.set(13, 0.2)
    pred = copy(pred, obs)
    pred = pred.set(4, 0.15)

    var t = 0
    var acc = 0
    for t < STEPS {
        obs = obs.set(4, 0.25 - (0.0 + (t % 20)) * 0.01)
        scores = actionScores(
            obs, pred, scores, N_ACTIONS, HORIZON, REL, THREAT,
            CELL, PREF, EPI, WALL, GOAL_B, THREAT_G, COMPLEXITY
        )
        acc = acc + checksum(scores)
        t = t + 1
    }
    println(acc)
}
