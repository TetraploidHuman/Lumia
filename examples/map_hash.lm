module MapHash

import std.io.{println}

type Option {
    Some(value)
    None
}

val unwrap_or(opt, d) = {
    opt match {
        None -> d
        Some(n) -> n
    }
}

/// Build a map large enough to promote past SmallMap into HashOrdered.
val main = {
    var m = mapOf()
    var i = 0
    for i < 40 {
        m = m.set(i, i * 3)
        i = i + 1
    }
    println(m.len())
    println(unwrap_or(m.get(0), -1))
    println(unwrap_or(m.get(39), -1))
    println(unwrap_or(m.get(100), -1))
    println(m.contains(20))
    println(m.contains(99))

    // Overwrite keeps insertion position
    m = m.set(7, 777)
    println(unwrap_or(m.get(7), -1))

    m = m.remove(0)
    println(m.len())
    println(m.contains(0))
    println(unwrap_or(m.get(1), -1))

    // Insertion order: after removing 0, first key is 1
    println(m.keys().get(0))
}
