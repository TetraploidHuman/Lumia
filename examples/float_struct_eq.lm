module FloatStructEq

import lumi.io.{println}

type Option {
    Some(Float)
    None
}

/// Structural `==` on Float containers must follow IEEE (±0 equal; NaN ≠ NaN).
val main = {
    println(if listOf(0.0) == listOf(-0.0) { 1 } else { 0 })
    val nan = 0.0 / 0.0
    println(if listOf(nan) == listOf(nan) { 1 } else { 0 })
    println(if Some(0.0) == Some(-0.0) { 1 } else { 0 })
    println(if Some(nan) == Some(nan) { 1 } else { 0 })
    println(if mapOf(1 to 0.0) == mapOf(1 to -0.0) { 1 } else { 0 })
    println(if mapOf(1 to nan) == mapOf(1 to nan) { 1 } else { 0 })
    // ListParMap must keep Float IEEE tagging (NaN ≠ NaN even for same list).
    val mapped = listOf(nan).map({ x -> x })
    println(if mapped == mapped { 1 } else { 0 })
}
