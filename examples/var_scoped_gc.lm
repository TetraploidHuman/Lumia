module var_scoped_gc
import lumi.io.{println}
import lumi.linalg.{zeros}

/// First assign to heap `var` inside `for` must stay GC-rooted across iterations.
val main = {
    var acc = 0.0
    var i = 0
    for i < 50 {
        // Fresh heap list each iteration; prior `pts` must remain rooted until overwrite.
        var pts = zeros(8)
        pts = pts.set(0, 1.0 + i)
        pts = pts.set(1, 2.0)
        // Allocate garbage to force minor/full GC while `pts` is live in the mut slot.
        var g = 0
        var junk = zeros(1)
        for g < 40 {
            junk = zeros(64)
            junk = junk.set(0, 0.0 + g)
            g = g + 1
        }
        acc = acc + pts.get(0) + pts.get(1)
        i = i + 1
    }
    println(acc)
}
