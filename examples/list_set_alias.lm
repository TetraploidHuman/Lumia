module ListSetAlias

import lumi.io.{println}

/// Regression: `val ys = xs.set(…)` must keep `xs` (codegen retains; set copies).
/// Contrast with `xs = xs.set(…)`, which may write in place when RC is unique.
val main = {
    var xs = listOf(1)
    xs = xs.append(2)
    xs = xs.append(3)
    val ys = xs.set(1, 99)
    println(xs.get(1))
    println(ys.get(1))
}
