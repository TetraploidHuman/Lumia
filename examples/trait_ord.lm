module TraitOrdDemo

import lumi.io.{println}

type Point {
    val x
    val y
}

trait Eq {
}

trait Ord requires Eq {
}

instance Eq for Point {
}

instance Ord for Point {
}

val main = {
    val a = Point { x = 1, y = 2 }
    val b = Point { x = 1, y = 3 }
    val c = Point { x = 2, y = 0 }
    println(a < b)
    println(b > a)
    println(a == a)
    println(c > b)
    println(a <= a)
}
