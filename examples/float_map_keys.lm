module FloatMapKeys

import lumi.io.{println}

/// Float Map/Set keys follow IEEE: ±0 collide; NaN never equals itself.
val main = {
    val m = mapOf(0.0 to 1)
    println(m.contains(-0.0))
    println(if 0.0 == -0.0 { 1 } else { 0 })

    val nan = 0.0 / 0.0
    val m2 = mapOf(nan to 2)
    println(m2.contains(nan))
    println(if nan == nan { 1 } else { 0 })

    val m3 = mapOf().set(0.0, 3)
    println(m3.contains(-0.0))

    val s = setOf(0.0)
    println(s.contains(-0.0))
}
