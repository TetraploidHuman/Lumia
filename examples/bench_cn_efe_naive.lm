module BenchCnEfeNaive

/// CogniNucleus EFE action scores in pure Lumi (imagine + G(a), horizon 2).
/// Compared against `std.efe.actionScores` RT kernel in `bench_cn_efe_kernel.lm`.
import std.io.{println}
import std.linalg.{zeros, copy, checksum, l2Norm, sub}

val OBS = 16
val N_ACTIONS = 4
val HORIZON = 2
val STEPS = 50000
val REL = 4
val THREAT = 11
val CELL = 0.25
val PREF = 1.2
val EPI = 0.28
val WALL = 3.2
val GOAL_B = 0.8
val THREAT_G = 2.0
val COMPLEXITY = 0.1

val fabs(x) = {
    if x < 0.0 { 0.0 - x } else { x }
}

val fmax(a, b) = {
    if a > b { a } else { b }
}

val daxOf(a) = {
    if a == 0 { 0.0 - 1.0 } else { if a == 1 { 1.0 } else { 0.0 } }
}

val dayOf(a) = {
    if a == 2 { 0.0 - 1.0 } else { if a == 3 { 1.0 } else { 0.0 } }
}

/// Kinematic imagination into `dst`. If blocked, `dst` stays a copy of `obs`
/// and `dst.get(REL+2+action) > 0.5` still holds (bump signal).
val imagine(obs, action, dst) = {
    var out = copy(dst, obs)
    val a = action % N_ACTIONS
    val blockI = REL + 2
    if out.get(blockI + a) > 0.5 {
        out
    } else {
        val dax = daxOf(a)
        val day = dayOf(a)
        out = out.set(0, {
            val v = out.get(0) + dax * CELL
            if v < 0.0 { 0.0 } else { if v > 1.0 { 1.0 } else { v } }
        })
        out = out.set(1, {
            val v = out.get(1) + day * CELL
            if v < 0.0 { 0.0 } else { if v > 1.0 { 1.0 } else { v } }
        })
        out = out.set(REL, out.get(REL) - dax * CELL)
        out = out.set(REL + 1, out.get(REL + 1) - day * CELL)
        out = out.set(THREAT, out.get(THREAT) - dax * CELL)
        out = out.set(THREAT + 1, out.get(THREAT + 1) - day * CELL)
        out = out.set(THREAT + 2, 0.0)
        var k = 0
        for k < 4 {
            out = out.set(blockI + k, 0.0)
            k = k + 1
        }
        out
    }
}

val wasBumped(imagined, action) = {
    imagined.get(REL + 2 + (action % N_ACTIONS)) > 0.5
}

val expectedG(imagined, pred, bumped, diff) = {
    val dx = imagined.get(REL)
    val dy = imagined.get(REL + 1)
    val dist = fabs(dx) + fabs(dy)
    val pref = dist - GOAL_B * fmax(0.0, 1.0 - 8.0 * dist)
    var d = sub(diff, imagined, pred)
    val epi = l2Norm(d)
    val wall = if bumped { 1.0 } else { 0.0 }
    val tdx = imagined.get(THREAT)
    val tdy = imagined.get(THREAT + 1)
    val local = imagined.get(THREAT + 2)
    val threat = local + 0.35 * fmax(0.0, 0.35 - (fabs(tdx) + fabs(tdy)))
    PREF * pref + EPI * epi + WALL * wall + THREAT_G * threat + COMPLEXITY
}

val actionScoresNaive(obs, pred, scores, scratch, scratch2, diff) = {
    var out = scores
    var a = 0
    for a < N_ACTIONS {
        val o1 = imagine(obs, a, scratch)
        val bumped = wasBumped(o1, a)
        val g1 = expectedG(o1, pred, bumped, diff)
        if HORIZON <= 1 {
            out = out.set(a, g1)
        } else {
            if bumped {
                out = out.set(a, g1)
            } else {
                var best = 1000000000.0
                var a2 = 0
                for a2 < N_ACTIONS {
                    val o2 = imagine(o1, a2, scratch2)
                    val bumped2 = wasBumped(o2, a2)
                    val g2 = expectedG(o2, pred, bumped2, diff)
                    if g2 < best {
                        best = g2
                    }
                    a2 = a2 + 1
                }
                out = out.set(a, g1 + 0.85 * best)
            }
        }
        a = a + 1
    }
    out
}

val main = {
    var obs = zeros(OBS)
    var pred = zeros(OBS)
    var scores = zeros(N_ACTIONS)
    var scratch = zeros(OBS)
    var scratch2 = zeros(OBS)
    var diff = zeros(OBS)

    obs = obs.set(0, 0.5)
    obs = obs.set(1, 0.5)
    obs = obs.set(4, 0.25)
    obs = obs.set(5, 0.0)
    obs = obs.set(11, 0.1)
    obs = obs.set(12, 0.0)
    obs = obs.set(13, 0.2)
    pred = copy(pred, obs)
    pred = pred.set(4, 0.15)

    var t = 0
    var acc = 0
    for t < STEPS {
        obs = obs.set(4, 0.25 - (0.0 + (t % 20)) * 0.01)
        scores = actionScoresNaive(obs, pred, scores, scratch, scratch2, diff)
        acc = acc + checksum(scores)
        t = t + 1
    }
    println(acc)
}
