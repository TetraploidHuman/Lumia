module FuseHof

import lumi.io.{println}

val main = {
    val xs = listOf(1, 2, 3, 4, 5)
    val s = xs >> map { it * 2 } >> filter { it > 4 } >> fold(0, { acc, x -> acc + x })
    println(s)

    val t = (0..<1000)
        .map({ x -> x + 1 })
        .filter({ x -> x % 2 == 0 })
        .fold(0, { acc, x -> acc + x })
    println(t)

    // Fused build (map+filter → one pass, no intermediate list).
    val ys = xs.map({ x -> x * 10 }).filter({ x -> x > 20 })
    println(ys.len)
    println(ys.get(0))
}
