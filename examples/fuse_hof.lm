module FuseHof

import std.io.{println}

val main = {
    val xs = listOf(1, 2, 3, 4, 5)
    val s = xs >> map { it * 2 } >> filter { it > 4 } >> fold(0, { acc, x -> acc + x })
    println(s)

    val t = (0..<1000)
        .map({ x -> x + 1 })
        .filter({ x -> x % 2 == 0 })
        .fold(0, { acc, x -> acc + x })
    println(t)
}
