module PolyTopDbl

fun dbl(x) effect.io=false memo=None {
  %1 = %0 + %0  // pure
  return %1
}

fun dbl$Float(x) effect.io=false memo=None {
  %1 = %0 + %0  // pure
  return %1
}

fun dbl$Float$c_x3ff8000000000000() effect.io=false memo=None {
  %2 = f64 1.5  // pure
  %1 = %2 + %2  // pure
  return %1
}

fun dbl$c_1() effect.io=false memo=None {
  %2 = i64 1  // pure
  %1 = i64 2  // pure
  return %1
}

fun main() effect.io=true memo=None {
  %0 = i64 1  // pure
  %1 = call dbl$c_1()  // pure
  %2 = builtin Println(%1)  // effect
  %3 = f64 1.5  // pure
  %4 = call dbl$Float$c_x3ff8000000000000()  // pure
  %5 = builtin Println(%4)  // effect
  return %5
}
