module MemoLocal

fun main() effect.io=true memo=None {
  %2 = i64 42  // pure
  %4 = builtin Println(%2)  // effect
  %5 = builtin Println(%2)  // effect
  %6 = i64 0  // pure
  i := %6
  acc := %6
  %8 = i64 10  // pure
  %9 = i64 3  // pure
  %17 = i64 1  // pure
  %19 = loop ...  // effect
  %20 = load acc  // pure
  %21 = builtin Println(%20)  // effect
  return %21
}
