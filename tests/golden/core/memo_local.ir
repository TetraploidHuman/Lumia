module MemoLocal

fun main() effect.io=true memo=None {
  %0 = i64 21  // pure
  %2 = i64 42  // pure
  %3 = i64 42  // pure
  %4 = call println(%2)  // effect
  %5 = call println(%3)  // effect
  %6 = i64 0  // pure
  i := %6
  acc := %6
  %8 = i64 10  // pure
  %9 = i64 3  // pure
  %17 = i64 1  // pure
  %19 = loop ...  // effect
  %20 = load acc  // pure
  %21 = call println(%20)  // effect
  return %21
}

fun println(x) effect.io=true memo=None {
  %1 = builtin Println(%0)  // effect
  return %1
}
