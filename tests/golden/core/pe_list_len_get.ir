module PeListLenGet

fun main() effect.io=true memo=None {
  %0 = i64 10  // pure
  %1 = i64 20  // pure
  %2 = i64 30  // pure
  %3 = alloc_list[LitList](n=3)  // pure
  %4 = i64 3  // pure
  %5 = builtin Println(%4)  // effect
  %8 = builtin Println(%0)  // effect
  %11 = builtin Println(%2)  // effect
  %19 = i64 60  // pure
  %20 = builtin Println(%19)  // effect
  return %20
}
