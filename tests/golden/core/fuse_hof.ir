  %14 = i64 2  // pure
  %16 = i64 4  // pure
  %24 = loop ...  // effect
  %25 = load __fuse_acc_112  // pure
  %26 = call println(%25)  // effect
  __fuse_acc_217 := %6
  __i_217 := %6
  %33 = i64 1  // pure
  %35 = i64 2  // pure
