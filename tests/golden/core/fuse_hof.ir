module FuseHof

fun main() effect.io=true memo=None {
  %0 = i64 1  // pure
  %1 = i64 2  // pure
  %2 = i64 3  // pure
  %3 = i64 4  // pure
  %4 = i64 5  // pure
  %5 = alloc_list[HeapList](n=5)  // pure
  %6 = i64 0  // pure
  __fuse_acc_112 := %6
  %7 = builtin Elems(%5)  // pure
  %8 = builtin ListLen(%7)  // pure
  __i_112 := %6
  %14 = i64 2  // pure
  %16 = i64 4  // pure
  %24 = loop ...  // effect
  %25 = load __fuse_acc_112  // pure
  %26 = call println(%25)  // effect
  __fuse_acc_217 := %6
  __i_217 := %6
  %33 = i64 1  // pure
  %35 = i64 2  // pure
  %37 = i64 0  // pure
  %45 = loop ...  // effect
  %46 = load __fuse_acc_217  // pure
  %47 = call println(%46)  // effect
  return %47
}

fun println(x) effect.io=true memo=None {
  %1 = builtin Println(%0)  // effect
