module FloatOps

fun main() effect.io=true memo=None {
  %0 = f64 1.5  // pure
  %1 = f64 2.25  // pure
  %2 = %0 + %1  // pure
  %3 = call println$Float(%2)  // effect
  %4 = f64 3  // pure
  %5 = f64 2  // pure
  %6 = %4 * %5  // pure
  %7 = call println$Float(%6)  // effect
  %8 = %0  // pure
  %9 = %5  // pure
  %10 = %0 < %5  // pure
  %13 = if ...  // pure
  %14 = call println(%13)  // effect
  %15 = %0  // pure
  %16 = Neg %0  // pure
  %17 = call println$Float(%16)  // effect
  %18 = %0  // pure
  %19 = f64 2.5  // pure
  %20 = alloc_list[LitList](n=2)  // pure
  %21 = i64 0  // pure
  %22 = %0  // pure
  %23 = i64 1  // pure
  %24 = %19  // pure
  %25 = %0 + %19  // pure
  %26 = call println$Float(%25)  // effect
  return %26
}

fun println(x) effect.io=true memo=None {
  %1 = builtin Println(%0)  // effect
  return %1
}

fun println$Float(x) effect.io=true memo=None {
  %1 = builtin Println(%0)  // effect
  return %1
}
