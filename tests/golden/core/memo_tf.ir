module MemoTf

fun main() effect.io=true memo=None {
  %0 = i64 200  // pure
  %1 = call sqsum(%0)  // pure
  %2 = builtin Println(%1)  // effect
  %5 = builtin Println(%1)  // effect
  %6 = i64 10  // pure
  %7 = call sqsum(%6)  // pure
  %8 = builtin Println(%7)  // effect
  return %8
}

fun sqsum(n) effect.io=false memo=Some(Slots { id: 0 }) {
  %1 = i64 0  // pure
  a := %1
  __i_221 := %1
  %12 = loop ...  // effect
  %13 = load a  // pure
  return %13
}
