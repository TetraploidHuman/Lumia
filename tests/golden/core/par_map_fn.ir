module ParMapFn

fun double(x) effect.io=false memo=None {
  %1 = i64 2  // pure
  %2 = %0 * %1  // pure
  return %2
}

fun main() effect.io=true memo=None {
  %0 = i64 0  // pure
  %1 = i64 50  // pure
  %2 = builtin Range(%0, %1)  // pure
  %3 = funref double  // pure
  %4 = builtin ListParMap(%2, %3)  // pure
  %5 = builtin ListLen(%4)  // pure
  %6 = builtin Println(%5)  // effect
  %7 = %0  // pure
  %8 = builtin ListGet(%4, %0)  // pure
  %9 = builtin Println(%8)  // effect
  %10 = i64 49  // pure
  %11 = builtin ListGet(%4, %10)  // pure
  %12 = builtin Println(%11)  // effect
  return %12
}
