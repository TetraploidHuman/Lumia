module EscapePureLen

fun len(xs) effect.io=false memo=None {
  %1 = builtin ListLen(%0)  // pure
  return %1
}

fun main() effect.io=true memo=None {
  %0 = i64 10  // pure
  %1 = i64 20  // pure
  %2 = i64 30  // pure
  %3 = alloc_list[LitList](n=3)  // pure
  %4 = i64 3  // pure
  %5 = builtin Println(%4)  // effect
  %6 = i64 1  // pure
  %7 = %1  // pure
  %8 = builtin Println(%1)  // effect
  return %8
}
