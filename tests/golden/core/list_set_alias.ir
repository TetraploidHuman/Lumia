module ListSetAlias

fun main() effect.io=true memo=None {
  %0 = i64 1  // pure
  %1 = alloc_list[HeapList](n=1)  // pure
  xs := %1
  %2 = load xs  // pure
  %3 = i64 2  // pure
  %4 = builtin ListAppend(%2, %3)  // pure
  xs := %4
  %5 = load xs  // pure
  %6 = i64 3  // pure
  %7 = builtin ListAppend(%5, %6)  // pure
  xs := %7
  %8 = load xs  // pure
  %9 = %0  // pure
  %10 = i64 99  // pure
  %11 = builtin MapSet(%8, %0, %10)  // pure
  %12 = load xs  // pure
  %13 = %0  // pure
  %14 = builtin ListGet(%12, %0)  // pure
  %15 = call println(%14)  // effect
  %16 = %0  // pure
  %17 = builtin ListGet(%11, %0)  // pure
  %18 = call println(%17)  // effect
  return %18
}

fun println(x) effect.io=true memo=None {
  %1 = builtin Println(%0)  // effect
  return %1
}
