/// Dense `List[Float]` linear algebra (`import std.linalg.{…}`).
///
/// Matrices are **flat row-major** float lists. Dest buffers that are uniquely
/// owned are updated in place (zero-alloc); shared ones COW-clone.
///
/// @exports zeros, fill, l2Norm, l2Normalize, clamp, gemv, gemvT, addmm, checksum
module linalg

foreign "C" pure fn lumia_list_f64_zeros(n: Int) -> ListFloat
foreign "C" pure fn lumia_f64_fill(xs: ListFloat, v: Float) -> ListFloat
foreign "C" pure fn lumia_f64_l2_norm(xs: ListFloat) -> Float
foreign "C" pure fn lumia_f64_l2_normalize(xs: ListFloat, eps: Float) -> ListFloat
foreign "C" pure fn lumia_f64_clamp(xs: ListFloat, lo: Float, hi: Float) -> ListFloat
foreign "C" pure fn lumia_f64_gemv(m: Int, n: Int, a: ListFloat, x: ListFloat, y: ListFloat) -> ListFloat
foreign "C" pure fn lumia_f64_gemv_t(m: Int, n: Int, a: ListFloat, x: ListFloat, y: ListFloat) -> ListFloat
foreign "C" pure fn lumia_f64_addmm(m: Int, n: Int, w: ListFloat, u: ListFloat, v: ListFloat, alpha: Float) -> ListFloat
foreign "C" pure fn lumia_f64_checksum(xs: ListFloat) -> Int

val zeros = { n -> lumia_list_f64_zeros(n) }
val fill = { xs, v -> lumia_f64_fill(xs, v) }
val l2Norm = { xs -> lumia_f64_l2_norm(xs) }
val l2Normalize = { xs, eps -> lumia_f64_l2_normalize(xs, eps) }
val clamp = { xs, lo, hi -> lumia_f64_clamp(xs, lo, hi) }
val gemv = { m, n, a, x, y -> lumia_f64_gemv(m, n, a, x, y) }
val gemvT = { m, n, a, x, y -> lumia_f64_gemv_t(m, n, a, x, y) }
val addmm = { m, n, w, u, v, alpha -> lumia_f64_addmm(m, n, w, u, v, alpha) }
val checksum = { xs -> lumia_f64_checksum(xs) }
