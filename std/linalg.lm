/// Deprecated alias — use `import extras.linalg.{…}`.
///
/// Kept so older snippets that still say `std.linalg` keep resolving during
/// the migration window. Prefer `extras.linalg` in new code.
///
/// @exports zeros, fill, scale, mul, add, l2Norm, l2Normalize, sumSq, mean, std, softMax, clamp, gemv, gemvT, addmm, axpy, sub, copy, checksum, sqrtF, expF, sinF, cosF, atan2F, hypotF
module linalg

import extras.linalg.{
  zeros, fill, scale, mul, add, l2Norm, l2Normalize, sumSq, mean, std, softMax,
  clamp, gemv, gemvT, addmm, axpy, sub, copy, checksum, sqrtF, expF, sinF, cosF,
  atan2F, hypotF
}
