/// Standard I/O surface (`import lumi.io.{println, …}`).
///
/// Entry modules auto-import `lumi.io.*` (Kotlin-style). Explicit imports
/// override defaults. Bodies lower to compiler builtins (`println` / `assert` /
/// `readStdin`) so polymorphic show / assert messages stay intact.
///
/// @exports println, readStdin, assert
module io

val readStdin = { readStdin() }
val println(x) = { println(x) }
val assert(c) = { assert(c) }
