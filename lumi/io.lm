/// Standard I/O surface (`import lumi.io.{println, …}`).
///
/// Entry modules auto-import `lumi.io.*` (Kotlin-style). User code calls these
/// vals; bodies lower to compiler intrinsics (`__println`, …).
///
/// @exports println, readStdin, assert
module io

val readStdin = { __readStdin() }
val println(x) = { __println(x) }
val assert(c) = { __assert(c) }
