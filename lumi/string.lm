/// Standard string surface (`import lumi.string.{trim, split, …}`).
///
/// Thin wrappers over `lumi_rt` (`foreign "C"` + `lumi_*` symbols use the
/// runtime object ABI — String/List as heap pointers, not C `cstr`).
///
/// @exports trim, split, substring, toLower, toUpper, startsWith, endsWith, join
module string

foreign "C" pure fn lumi_str_trim(s: String) -> String
foreign "C" pure fn lumi_str_split(s: String, sep: Char) -> ListString
foreign "C" pure fn lumi_str_substring(s: String, start: Int, end: Int) -> String
foreign "C" pure fn lumi_str_to_lower(s: String) -> String
foreign "C" pure fn lumi_str_to_upper(s: String) -> String
foreign "C" pure fn lumi_str_starts_with(s: String, prefix: String) -> Int
foreign "C" pure fn lumi_str_ends_with(s: String, suffix: String) -> Int
foreign "C" pure fn lumi_list_join(xs: ListString, sep: String) -> String

val trim(s) = { lumi_str_trim(s) }
val split(s, sep) = { lumi_str_split(s, sep) }
val substring(s, start, end) = { lumi_str_substring(s, start, end) }
val toLower(s) = { lumi_str_to_lower(s) }
val toUpper(s) = { lumi_str_to_upper(s) }
val startsWith(s, prefix) = { lumi_str_starts_with(s, prefix) != 0 }
val endsWith(s, suffix) = { lumi_str_ends_with(s, suffix) != 0 }
val join(xs, sep) = { lumi_list_join(xs, sep) }
