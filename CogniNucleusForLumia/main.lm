/// CogniNucleus-For-Lumia entry: one GridWorld episode with the strict triad agent.
///
/// Port coverage (v0.1):
///   - nucleus / connection / cluster rates / learn_generative / update_state
///   - strict-PE triad forward + Hebbian μ⊗ε + EFE action selection
///   - grid env (no obstacles/threats)
/// Not yet: hippocampus, amygdala, hypothalamus, prune/grow, embodied MiniEcoWorld.
module main

import std.io.{println}
import config.{MAX_STEPS}
import env.{newWorld, stepEnv, observe}
import agent.{newAgent, forward, learn}

val main = {
    var world = newWorld
    var ag = newAgent
    var totalReward = 0.0
    var steps = 0
    var done = 0
    var actSum = 0
    var t = 0

    for t < MAX_STEPS {
        done match {
            0 -> {
                val obs = observe(world)
                val fo = forward(ag, obs)
                ag = fo.agent
                val action = fo.action
                val so = stepEnv(world, action)
                world = so.world
                ag = learn(ag, so.reward)
                totalReward = totalReward + so.reward
                actSum = actSum + action * (steps + 1)
                done = so.done
                steps = steps + 1
            }
            _ -> {}
        }
        t = t + 1
    }

    println(steps)
    println(actSum)
    println(done)
    println(world.lastReward)
    println(world.ax)
    println(world.ay)
}
