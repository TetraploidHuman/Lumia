/// Mirror of CogniNucleus `eval_behaviors.py --smoke --stage D2 --ablation amy_motor`.
/// Prints key metrics line-by-line (no JSON).
module eval_behaviors_smoke

import std.io.{println}
import d2_config.{TRAIN_EP, EVAL_EP, MAX_STEPS}
import eco.{newEco, resetEco, stepEco, stepEcoSeed, observeEco, randomAction, withEcoHunger}
import d2_agent.{newD2, forwardD2, learnD2, lesionAmyMotor, resetD2}

type Roll {
    val rollEco
    val rollParts
    val meanFood
    val meanThreat
    val meanDisp
}

type EpOut {
    val epEco
    val epParts
    val epFood
    val epThreat
    val epDisp
}

val runEpisode = { eco0, parts0, useAgent, doLearn, explore, hungerInit ->
    var eco = resetEco(eco0)
    match {
        hungerInit >= 0.0 -> { eco = withEcoHunger(eco, hungerInit) }
        _ -> {}
    }
    var parts = useAgent match {
        1 -> resetD2(parts0)
        _ -> parts0
    }
    var disp = 0.0
    var done = 0
    var t = 0
    for t < MAX_STEPS {
        done match {
            0 -> {
                val obs = observeEco(eco)
                useAgent match {
                    1 -> {
                        val fo = forwardD2(parts, obs, explore, eco.ecoRng)
                        parts = fo.fwdAgent
                        val so = stepEcoSeed(eco, fo.fwdAction, fo.fwdSeed)
                        val rew = 0.0 + so.stepReward
                        val dlt = 0.0 + so.stepDisp
                        eco = so.stepEco
                        disp = disp + dlt
                        done = so.stepDone
                        doLearn match {
                            1 -> { parts = learnD2(parts, rew) }
                            _ -> {}
                        }
                    }
                    _ -> {
                        val ra = randomAction(eco)
                        eco = ra.actEco
                        val so = stepEco(eco, ra.actId)
                        val dlt = 0.0 + so.stepDisp
                        eco = so.stepEco
                        disp = disp + dlt
                        done = so.stepDone
                    }
                }
            }
            _ -> { break }
        }
        t = t + 1
    }
    EpOut {
        epEco = eco,
        epParts = parts,
        epFood = eco.ecoFoodVisits,
        epThreat = eco.ecoThreatContacts,
        epDisp = disp
    }
}

val rollout = { eco0, parts0, nEp, useAgent, doLearn, explore, hungerInit ->
    var eco = eco0
    var parts = parts0
    var sumFood = 0.0
    var sumThreat = 0.0
    var sumDisp = 0.0
    var ep = 0
    for ep < nEp {
        val out = runEpisode(eco, parts, useAgent, doLearn, explore, hungerInit)
        eco = out.epEco
        parts = out.epParts
        sumFood = sumFood + (0.0 + out.epFood)
        sumThreat = sumThreat + (0.0 + out.epThreat)
        sumDisp = sumDisp + out.epDisp
        ep = ep + 1
    }
    val n = 0.0 + nEp
    Roll {
        rollEco = eco,
        rollParts = parts,
        meanFood = sumFood / n,
        meanThreat = sumThreat / n,
        meanDisp = sumDisp / n
    }
}

val main = {
    println("=== behaviors stage=D2 ablation=amy_motor seeds=[0] train=50 eval=15 ===")
    // Allocate agent before env: large ADT alloc after Eco can corrupt live lists (GC/rooting).
    var parts = newD2
    var eco = newEco(0.0)

    var ep = 0
    for ep < TRAIN_EP {
        // Python train: explore=True, learn=True
        val out = runEpisode(eco, parts, 1, 1, 1, 0.0 - 1.0)
        eco = out.epEco
        parts = out.epParts
        match {
            (ep + 1) % 10 == 0 -> {
                println("train_ep")
                println(ep + 1)
            }
            _ -> {}
        }
        ep = ep + 1
    }

    // random policy (Python explore=True on random_policy path is env.random_policy)
    val randR = rollout(eco, parts, EVAL_EP, 0, 0, 0, 0.0 - 1.0)
    eco = randR.rollEco
    parts = randR.rollParts

    // agent eval: explore=False
    val agentR = rollout(eco, parts, EVAL_EP, 1, 0, 0, 0.0 - 1.0)
    eco = agentR.rollEco
    parts = agentR.rollParts

    // B3: hungry vs sated displacement (Python homeo_eps = max(8, eval//3))
    val homeoEp = 8
    val hungryR = rollout(eco, parts, homeoEp, 1, 0, 0, 0.85)
    eco = hungryR.rollEco
    parts = hungryR.rollParts
    val satedR = rollout(eco, parts, homeoEp, 1, 0, 0, 0.12)
    eco = satedR.rollEco
    parts = satedR.rollParts
    val satedGate = match {
        satedR.meanDisp * 1.3 > 0.5 -> satedR.meanDisp * 1.3
        _ -> 0.5
    }

    val b1 = match { agentR.meanFood > randR.meanFood * 1.15 -> 1 _ -> 0 }
    val b2 = match { agentR.meanThreat < randR.meanThreat * 0.85 -> 1 _ -> 0 }
    val b3 = match { hungryR.meanDisp > satedGate -> 1 _ -> 0 }
    val passRate = (0.0 + b1 + b2 + b3) / 3.0

    parts = lesionAmyMotor(parts)
    val ablR = rollout(eco, parts, EVAL_EP, 1, 0, 0, 0.0 - 1.0)
    val b2Delta = ablR.meanThreat - agentR.meanThreat
    val b8 = match { b2Delta > 0.5 -> 1 _ -> 0 }

    // Guard against Float-as-Int codegen bugs (IEEE bits printed as i64).
    val sane = match {
        randR.meanThreat > 1000000.0 -> 0
        agentR.meanDisp > 1000000.0 -> 0
        hungryR.meanDisp > 1000000.0 -> 0
        _ -> 1
    }
    println("metrics_sane")
    println(sane)

    println("random_mean_food")
    println(randR.meanFood)
    println("random_mean_threat")
    println(randR.meanThreat)
    println("random_mean_disp")
    println(randR.meanDisp)
    println("agent_mean_food")
    println(agentR.meanFood)
    println("agent_mean_threat")
    println(agentR.meanThreat)
    println("agent_mean_disp")
    println(agentR.meanDisp)
    println("hungry_disp")
    println(hungryR.meanDisp)
    println("sated_disp")
    println(satedR.meanDisp)
    println("B1")
    println(b1)
    println("B2")
    println(b2)
    println("B3")
    println(b3)
    println("pass_rate")
    println(passRate)
    println("ablation_mean_threat")
    println(ablR.meanThreat)
    println("B2_threat_delta")
    println(b2Delta)
    println("B8_amy_lesion_worse")
    println(b8)
}
