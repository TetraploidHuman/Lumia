/// Discrete grid world (`cogninucleus.env.GridWorld`), no obstacles/threats.
/// Observation layout matches CN: agent(2), goal(2), rel(2), blocked(4),
/// visible(1), threat_rel(2), threat_local(1) padded to OBS_PAD.
///
/// Positions are Float for Lumia numeric uniformity in this ADT.
///
/// @exports World, StepOut, newWorld, reset, observe, stepEnv
module env

import std.linalg.{zeros}
import config.{GRID, MAX_STEPS, STEP_PENALTY, GOAL_REWARD, SHAPING, OBS_PAD}

type World {
    val ax
    val ay
    val gx
    val gy
    val steps
    val prevDist
    val obs
    val lastReward
}

type StepOut {
    val world
    val reward
    val done
}

val gridF = 0.0 + GRID

val absF = { x ->
    match {
        x < 0.0 -> 0.0 - x
        _ -> x
    }
}

val manhattan = { ax, ay, gx, gy ->
    absF(ax - gx) + absF(ay - gy)
}

val blocked01 = { blocked ->
    match {
        blocked -> 1.0
        _ -> 0.0
    }
}

val writeObs = { w ->
    val g = gridF - 1.0
    var obs = w.obs
    var i = 0
    for i < OBS_PAD {
        obs = obs.set(i, 0.0)
        i = i + 1
    }
    obs = obs.set(0, w.ax / g)
    obs = obs.set(1, w.ay / g)
    obs = obs.set(2, w.gx / g)
    obs = obs.set(3, w.gy / g)
    obs = obs.set(4, (w.gx - w.ax) / g)
    obs = obs.set(5, (w.gy - w.ay) / g)
    obs = obs.set(6, blocked01(w.ax - 1.0 < 0.0))
    obs = obs.set(7, blocked01(w.ax + 1.0 >= gridF))
    obs = obs.set(8, blocked01(w.ay - 1.0 < 0.0))
    obs = obs.set(9, blocked01(w.ay + 1.0 >= gridF))
    obs = obs.set(10, 1.0)
    w with { obs = obs }
}

val newWorld = writeObs(World {
    ax = 0.0,
    ay = 0.0,
    gx = gridF - 1.0,
    gy = gridF - 1.0,
    steps = 0,
    prevDist = manhattan(0.0, 0.0, gridF - 1.0, gridF - 1.0),
    obs = zeros(OBS_PAD),
    lastReward = 0.0
})

val reset = { _w ->
    newWorld
}

val observe = { w ->
    w.obs
}

val clampAction = { action ->
    match {
        action < 0 -> 0
        action > 3 -> action % 4
        _ -> action
    }
}

val actionDelta = { a ->
    a match {
        0 -> (0.0 - 1.0, 0.0)
        1 -> (1.0, 0.0)
        2 -> (0.0, 0.0 - 1.0)
        _ -> (0.0, 1.0)
    }
}

val inBounds = { x, y ->
    match {
        x < 0.0 -> false
        y < 0.0 -> false
        x >= gridF -> false
        y >= gridF -> false
        _ -> true
    }
}

val stepEnv = { w, action ->
    val a = clampAction(action)
    val dxy = actionDelta(a)
    val nx = w.ax + dxy.0
    val ny = w.ay + dxy.1
    val (ax, ay) = inBounds(nx, ny) match {
        true -> (nx, ny)
        false -> (w.ax, w.ay)
    }
    val steps = w.steps + 1
    val dist = manhattan(ax, ay, w.gx, w.gy)
    val reached = (ax == w.gx and ay == w.gy) match {
        true -> 1
        false -> 0
    }
    val shaping = SHAPING * (w.prevDist - dist)
    val reward = reached match {
        1 -> GOAL_REWARD + shaping
        _ -> STEP_PENALTY + shaping
    }
    val doneFlag = match {
        reached == 1 -> 1
        steps >= MAX_STEPS -> 1
        _ -> 0
    }
    var world = w with {
        ax = ax,
        ay = ay,
        steps = steps,
        prevDist = dist,
        lastReward = reward
    }
    world = writeObs(world)
    StepOut { world = world, reward = reward, done = doneFlag }
}
