/// Discrete grid world (`cogninucleus.env.GridWorld`), no obstacles/threats.
/// Observation layout matches CN: agent(2), goal(2), rel(2), blocked(4),
/// visible(1), threat_rel(2), threat_local(1) padded to OBS_PAD.
///
/// Positions are Float for Lumia numeric uniformity in this ADT.
///
/// @exports World, StepOut, newWorld, reset, observe, stepEnv
module env

import std.linalg.{zeros}
import config.{GRID, MAX_STEPS, STEP_PENALTY, GOAL_REWARD, SHAPING, OBS_PAD}

type World {
    val ax
    val ay
    val gx
    val gy
    val steps
    val prevDist
    val obs
    val lastReward
}

type StepOut {
    val world
    val reward
    val done
}

val gridF = 0.0 + GRID

val manhattan = { ax, ay, gx, gy ->
    val dx = if ax > gx { ax - gx } else { gx - ax }
    val dy = if ay > gy { ay - gy } else { gy - ay }
    dx + dy
}

val writeObs = { w ->
    val g = gridF - 1.0
    var obs = w.obs
    var i = 0
    for i < OBS_PAD {
        obs = obs.set(i, 0.0)
        i = i + 1
    }
    obs = obs.set(0, w.ax / g)
    obs = obs.set(1, w.ay / g)
    obs = obs.set(2, w.gx / g)
    obs = obs.set(3, w.gy / g)
    obs = obs.set(4, (w.gx - w.ax) / g)
    obs = obs.set(5, (w.gy - w.ay) / g)
    val uBlocked = if w.ax - 1.0 < 0.0 { 1.0 } else { 0.0 }
    val dBlocked = if w.ax + 1.0 >= gridF { 1.0 } else { 0.0 }
    val lBlocked = if w.ay - 1.0 < 0.0 { 1.0 } else { 0.0 }
    val rBlocked = if w.ay + 1.0 >= gridF { 1.0 } else { 0.0 }
    obs = obs.set(6, uBlocked)
    obs = obs.set(7, dBlocked)
    obs = obs.set(8, lBlocked)
    obs = obs.set(9, rBlocked)
    obs = obs.set(10, 1.0)
    w with { obs = obs }
}

val newWorld = writeObs(World {
    ax = 0.0,
    ay = 0.0,
    gx = gridF - 1.0,
    gy = gridF - 1.0,
    steps = 0,
    prevDist = manhattan(0.0, 0.0, gridF - 1.0, gridF - 1.0),
    obs = zeros(OBS_PAD),
    lastReward = 0.0
})

val reset = { _w ->
    newWorld
}

val observe = { w ->
    w.obs
}

val stepEnv = { w, action ->
    val a = if action < 0 { 0 } else { if action > 3 { action % 4 } else { action } }
    var nx = w.ax
    var ny = w.ay
    if a == 0 {
        nx = w.ax - 1.0
    } else {
        if a == 1 {
            nx = w.ax + 1.0
        } else {
            if a == 2 {
                ny = w.ay - 1.0
            } else {
                ny = w.ay + 1.0
            }
        }
    }
    var ax = w.ax
    var ay = w.ay
    val okX = if nx < 0.0 { 0 } else { if nx >= gridF { 0 } else { 1 } }
    val okY = if ny < 0.0 { 0 } else { if ny >= gridF { 0 } else { 1 } }
    if okX == 1 {
        if okY == 1 {
            ax = nx
            ay = ny
        }
    }
    val steps = w.steps + 1
    val dist = manhattan(ax, ay, w.gx, w.gy)
    val reached = if ax == w.gx { if ay == w.gy { 1 } else { 0 } } else { 0 }
    val shaping = SHAPING * (w.prevDist - dist)
    var reward = STEP_PENALTY + shaping
    if reached == 1 {
        reward = GOAL_REWARD + shaping
    }
    val doneFlag = if reached == 1 { 1 } else { if steps >= MAX_STEPS { 1 } else { 0 } }
    var world = w with {
        ax = ax,
        ay = ay,
        steps = steps,
        prevDist = dist,
        lastReward = reward
    }
    world = writeObs(world)
    StepOut { world = world, reward = reward, done = doneFlag }
}
