/// Strict-PE triad FreeEnergyAgent (vis / pfc / mot).
/// Ports the hot path of `cogninucleus.agent.FreeEnergyAgent` with hip/amy/hyp off.
///
/// @exports Agent, ForwardOut, newAgent, forward, learn
module agent

import std.linalg.{zeros, copy, sub, scale, add, gemv}
import std.cn.{updateState, argMax}
import std.efe.{actionScores}
import config.{
    VIS, PFC, MOT, STATE_LR, CONN_LR, GEN_LR, PI, MU_CLIP,
    EFE_MIX, REL, THREAT, CELL, PREF, EPI, WALL, GOAL_B, THREAT_G, COMPLEXITY, HORIZON
}
import nucleus.{newNucleus, openLoopTd, sensoryStep, learnGen}
import connection.{newConn, linkProject, linkProjectError, linkHebbian}

type Agent {
    val vis
    val pfc
    val mot
    val visPfc
    val pfcVis
    val pfcMot
    val zerosMot
    val gen
    val genErr
    val lat
    val halfLat
    val recog
    val recogErr
    val driveP
    val motTop
    val scores
    val logits
    val tmp
    val uVis
    val uPfc
    val vGen
    val vRec
    val vMot
    val lastAction
    val lastGenErr
    val lastRecogErr
    val lastMotErr
}

type ForwardOut {
    val agent
    val action
}

val newAgent = Agent {
    vis = newNucleus(VIS),
    pfc = newNucleus(PFC),
    mot = newNucleus(MOT),
    visPfc = newConn(VIS, PFC, 0.001),
    pfcVis = newConn(PFC, VIS, 0.001),
    pfcMot = newConn(PFC, MOT, 0.001),
    zerosMot = zeros(MOT),
    gen = zeros(VIS),
    genErr = zeros(VIS),
    lat = zeros(PFC),
    halfLat = zeros(PFC),
    recog = zeros(PFC),
    recogErr = zeros(PFC),
    driveP = zeros(PFC),
    motTop = zeros(MOT),
    scores = zeros(MOT),
    logits = zeros(MOT),
    tmp = zeros(MOT),
    uVis = zeros(VIS),
    uPfc = zeros(PFC),
    vGen = zeros(VIS),
    vRec = zeros(PFC),
    vMot = zeros(MOT),
    lastAction = 0,
    lastGenErr = zeros(VIS),
    lastRecogErr = zeros(PFC),
    lastMotErr = zeros(MOT)
}

val forward = { agent, obs ->
    var vis = agent.vis
    var pfc = agent.pfc
    var mot = agent.mot
    var visPfc = agent.visPfc
    var pfcVis = agent.pfcVis
    var pfcMot = agent.pfcMot
    var gen = agent.gen
    var genErr = agent.genErr
    var lat = agent.lat
    var halfLat = agent.halfLat
    var recog = agent.recog
    var recogErr = agent.recogErr
    var driveP = agent.driveP
    var motTop = agent.motTop
    var scores = agent.scores
    var logits = agent.logits
    var tmp = agent.tmp

    // 1) Sensory open-loop
    val tdV = openLoopTd(vis)
    vis = sensoryStep(vis, obs, tdV)

    // 3) PFC from visual PE
    driveP = linkProjectError(visPfc, vis.err, driveP)
    val tdP = openLoopTd(pfc)
    pfc = sensoryStep(pfc, driveP, tdP)

    // 4) Generative top-down + half-step lateral update_state
    gen = linkProject(pfcVis, pfc.mu, gen)
    genErr = sub(genErr, obs, gen)
    lat = gemv(PFC, VIS, pfcVis.w, genErr, lat)
    halfLat = copy(halfLat, lat)
    halfLat = scale(halfLat, 0.5)
    var muP = pfc.mu
    var encP = pfc.enc
    muP = updateState(muP, encP, halfLat, PFC, STATE_LR, PI, MU_CLIP)
    pfc = pfc with { mu = muP }
    gen = linkProject(pfcVis, pfc.mu, gen)
    genErr = sub(genErr, obs, gen)

    vis = sensoryStep(vis, obs, gen)

    recog = linkProject(visPfc, vis.mu, recog)
    recogErr = sub(recogErr, pfc.mu, recog)

    // 6) Motor: empty BU, PFC top-down
    motTop = linkProject(pfcMot, pfc.mu, motTop)
    mot = sensoryStep(mot, agent.zerosMot, motTop)

    scores = actionScores(
        obs, gen, scores, MOT, HORIZON, REL, THREAT,
        CELL, PREF, EPI, WALL, GOAL_B, THREAT_G, COMPLEXITY
    )
    logits = copy(logits, mot.mu)
    logits = scale(logits, 1.0 - EFE_MIX)
    tmp = copy(tmp, scores)
    tmp = scale(tmp, 0.0 - EFE_MIX)
    logits = add(logits, logits, tmp)
    val action = argMax(logits)

    val next = agent with {
        vis = vis,
        pfc = pfc,
        mot = mot,
        visPfc = visPfc,
        pfcVis = pfcVis,
        pfcMot = pfcMot,
        gen = gen,
        genErr = genErr,
        lat = lat,
        halfLat = halfLat,
        recog = recog,
        recogErr = recogErr,
        driveP = driveP,
        motTop = motTop,
        scores = scores,
        logits = logits,
        tmp = tmp,
        lastAction = action,
        lastGenErr = genErr,
        lastRecogErr = recogErr,
        lastMotErr = mot.err
    }
    ForwardOut { agent = next, action = action }
}

val learn = { agent, reward ->
    // Dopamine gate reserved; reward kept live so the signature matches CN learn(reward).
    val mod = if reward < 0.0 { 0.5 } else { if reward > 0.5 { 1.5 } else { 1.0 } }
    var vis = agent.vis
    var pfc = agent.pfc
    var mot = agent.mot
    var visPfc = agent.visPfc
    var pfcVis = agent.pfcVis
    var pfcMot = agent.pfcMot
    var uVis = agent.uVis
    var uPfc = agent.uPfc
    var vGen = agent.vGen
    var vRec = agent.vRec
    var vMot = agent.vMot

    uVis = copy(uVis, vis.mu)
    vRec = copy(vRec, agent.lastRecogErr)
    visPfc = linkHebbian(visPfc, uVis, vRec, CONN_LR * mod)

    uPfc = copy(uPfc, pfc.mu)
    vGen = copy(vGen, agent.lastGenErr)
    pfcVis = linkHebbian(pfcVis, uPfc, vGen, CONN_LR * 2.0 * mod)

    vMot = copy(vMot, agent.lastMotErr)
    pfcMot = linkHebbian(pfcMot, uPfc, vMot, CONN_LR * mod)

    vis = learnGen(vis, agent.lastGenErr, GEN_LR * 2.0 * mod)
    pfc = learnGen(pfc, agent.lastRecogErr, GEN_LR * 2.0 * mod)
    mot = learnGen(mot, agent.lastMotErr, GEN_LR * mod)

    agent with {
        vis = vis,
        pfc = pfc,
        mot = mot,
        visPfc = visPfc,
        pfcVis = pfcVis,
        pfcMot = pfcMot,
        uVis = uVis,
        uPfc = uPfc,
        vGen = vGen,
        vRec = vRec,
        vMot = vMot
    }
}
