/// MiniEcoWorld continuous 2D arena (`cogninucleus.embodied.world`).
/// Field names are globally unique (Lumia product-field rule).
///
/// @exports Eco, EcoStep, ActOut, newEco, resetEco, stepEco, stepEcoSeed, randomAction, observeEco, withEcoHunger, withEcoRng
module eco

import std.linalg.{zeros, fill, sinF, cosF, atan2F, hypotF}
import d2_config.{
    OBS_DIM, MAX_STEPS, N_FOODS, N_THREATS, MOVE_SPEED, TURN_ANGLE, FOV,
    FOOD_R, THREAT_R, NEST_R, HUNGER_RATE, HUNGER_EAT, PAIN_DECAY, PAIN_THREAT,
    ENERGY_COST, PAIN_W, FOOD_RESPAWN_DELAY, ARENA
}

type Eco {
    val ecoX
    val ecoY
    val ecoTheta
    val ecoHunger
    val ecoPain
    val ecoPrevHunger
    val ecoPrevPain
    val ecoSteps
    val ecoFoods
    /// Per-food cooldown: 0 = active, >0 = steps until respawn (Python food_respawn_delay).
    val ecoFoodTimers
    val ecoThreats
    val ecoNestX
    val ecoNestY
    val ecoFoodVisits
    val ecoThreatContacts
    val ecoObs
    val ecoRng
}

type EcoStep {
    val stepEco
    val stepReward
    val stepDone
    val stepDisp
}

type ActOut {
    val actId
    val actEco
}

type RngPair {
    val rngU
    val rngSeed
}

type PosPair {
    val posX
    val posY
}

type Bearing {
    val bearX
    val bearY
    val bearI
}

type PtsOut {
    val ptsData
    val ptsSeed
}

val PI2 = 3.141592653589793

val rngNext = { s ->
    // Float literals keep the LCG in the Float domain (Int `%` can bitcast seeds).
    ((s % 46340.0) * 48271.0 + 11.0) % 2147483647.0
}

val RNG_MOD = 2147483647.0

val rand01 = { s ->
    val s2 = rngNext(s)
    RngPair { rngU = s2 / RNG_MOD, rngSeed = s2 }
}

val randRange = { s, lo, hi ->
    val r = rand01(s)
    RngPair { rngU = lo + (hi - lo) * r.rngU, rngSeed = r.rngSeed }
}

val clampPos = { x, y ->
    val m = 0.03
    val hi = ARENA - m
    val cx = match {
        x < m -> m
        x > hi -> hi
        _ -> x
    }
    val cy = match {
        y < m -> m
        y > hi -> hi
        _ -> y
    }
    PosPair { posX = cx, posY = cy }
}

val bearing = { eco, tx, ty ->
    val dx = tx - eco.ecoX
    val dy = ty - eco.ecoY
    val dist = hypotF(dx, dy)
    match {
        dist < 0.000001 -> Bearing { bearX = 0.0, bearY = 0.0, bearI = 1.0 }
        _ -> {
            val ang = atan2F(dy, dx) - eco.ecoTheta
            val inten0 = 1.0 - dist / FOV
            val inten = match {
                inten0 < 0.0 -> 0.0
                _ -> inten0
            }
            Bearing { bearX = cosF(ang), bearY = sinF(ang), bearI = inten }
        }
    }
}

/// Nearest threat; read from `eco` (do not pass `ecoThreats` as a bare arg —
/// ephemeral list bases can be GC'd before the loop, zeroing threat obs).
val nearestThreat = { eco ->
    var bestBx = 0.0
    var bestBy = 0.0
    var bestI = 0.0
    var bestD = 1000000.0
    var i = 0
    for i < N_THREATS {
        val px = eco.ecoThreats.get(i * 2)
        val py = eco.ecoThreats.get(i * 2 + 1)
        val b = bearing(eco, px, py)
        val d = hypotF(px - eco.ecoX, py - eco.ecoY)
        match {
            d < bestD -> {
                bestD = d
                bestBx = b.bearX
                bestBy = b.bearY
                bestI = b.bearI
            }
            _ -> {}
        }
        i = i + 1
    }
    Bearing { bearX = bestBx, bearY = bestBy, bearI = bestI }
}

/// Nearest active food (timer == 0); matches Python iterating only present patches.
val nearestFood = { eco ->
    var bestBx = 0.0
    var bestBy = 0.0
    var bestI = 0.0
    var bestD = 1000000.0
    var i = 0
    for i < N_FOODS {
        match {
            eco.ecoFoodTimers.get(i) > 0.0 -> {}
            _ -> {
                val px = eco.ecoFoods.get(i * 2)
                val py = eco.ecoFoods.get(i * 2 + 1)
                val b = bearing(eco, px, py)
                val d = hypotF(px - eco.ecoX, py - eco.ecoY)
                match {
                    d < bestD -> {
                        bestD = d
                        bestBx = b.bearX
                        bestBy = b.bearY
                        bestI = b.bearI
                    }
                    _ -> {}
                }
            }
        }
        i = i + 1
    }
    Bearing { bearX = bestBx, bearY = bestBy, bearI = bestI }
}

val rayDist = { eco, angle ->
    val cx = eco.ecoX
    val cy = eco.ecoY
    val dx = cosF(angle)
    val dy = sinF(angle)
    var best = FOV
    match {
        dx > 0.000001 or dx < 0.0 - 0.000001 -> {
            val t0 = (0.0 - cx) / dx
            val t1 = (ARENA - cx) / dx
            match {
                t0 > 0.0001 -> { match { t0 < best -> { best = t0 } _ -> {} } }
                _ -> {}
            }
            match {
                t1 > 0.0001 -> { match { t1 < best -> { best = t1 } _ -> {} } }
                _ -> {}
            }
        }
        _ -> {}
    }
    match {
        dy > 0.000001 or dy < 0.0 - 0.000001 -> {
            val t0 = (0.0 - cy) / dy
            val t1 = (ARENA - cy) / dy
            match {
                t0 > 0.0001 -> { match { t0 < best -> { best = t0 } _ -> {} } }
                _ -> {}
            }
            match {
                t1 > 0.0001 -> { match { t1 < best -> { best = t1 } _ -> {} } }
                _ -> {}
            }
        }
        _ -> {}
    }
    best
}

val makeObs = { eco ->
    var obs = fill(eco.ecoObs, 0.0)
    obs = obs.set(0, cosF(eco.ecoTheta))
    obs = obs.set(1, sinF(eco.ecoTheta))
    obs = obs.set(2, eco.ecoX / ARENA)
    obs = obs.set(3, eco.ecoY / ARENA)
    val hung = match { eco.ecoHunger > 1.0 -> 1.0 _ -> eco.ecoHunger }
    val pain = match { eco.ecoPain > 1.0 -> 1.0 _ -> eco.ecoPain }
    obs = obs.set(4, hung)
    obs = obs.set(5, pain)
    val nf = nearestFood(eco)
    obs = obs.set(10, nf.bearX)
    obs = obs.set(11, nf.bearY)
    obs = obs.set(12, nf.bearI)
    val nt = nearestThreat(eco)
    obs = obs.set(14, nt.bearX)
    obs = obs.set(15, nt.bearY)
    obs = obs.set(16, nt.bearI)
    val nb = bearing(eco, eco.ecoNestX, eco.ecoNestY)
    obs = obs.set(18, nb.bearX)
    obs = obs.set(19, nb.bearY)
    obs = obs.set(20, nb.bearI)
    var r = 0
    for r < 8 {
        val ang = eco.ecoTheta + (0.0 + r) / 7.0 * PI2 * 0.75 - PI2 * 0.375
        val d = rayDist(eco, ang)
        val v = match { d / FOV > 1.0 -> 1.0 _ -> d / FOV }
        obs = obs.set(22 + r, v)
        r = r + 1
    }
    val margin = 0.08
    obs = obs.set(6, match { 1.0 - eco.ecoX / margin < 0.0 -> 0.0 _ -> 1.0 - eco.ecoX / margin })
    obs = obs.set(7, match { 1.0 - (ARENA - eco.ecoX) / margin < 0.0 -> 0.0 _ -> 1.0 - (ARENA - eco.ecoX) / margin })
    obs = obs.set(8, match { 1.0 - eco.ecoY / margin < 0.0 -> 0.0 _ -> 1.0 - eco.ecoY / margin })
    obs = obs.set(9, match { 1.0 - (ARENA - eco.ecoY) / margin < 0.0 -> 0.0 _ -> 1.0 - (ARENA - eco.ecoY) / margin })
    obs
}

val buildObs = { eco ->
    val obs = makeObs(eco)
    eco with { ecoObs = obs }
}

val fillPoints = { n, s0, lo, hi ->
    var pts = zeros(n * 2)
    var s = 0.0 + s0
    var i = 0
    for i < n {
        val rx = randRange(s, lo, hi)
        val ry = randRange(rx.rngSeed, lo, hi)
        pts = pts.set(i * 2, rx.rngU)
        pts = pts.set(i * 2 + 1, ry.rngU)
        s = ry.rngSeed
        i = i + 1
    }
    PtsOut { ptsData = pts, ptsSeed = s }
}

/// Allocate eco with RNG seed only — do **not** consume the LCG here.
/// Callers must `resetEco` before the first step (matches Python: construct →
/// install LCG(seed) → `reset()` once per episode).
val newEco = { seed ->
    Eco {
        ecoX = 0.5,
        ecoY = 0.5,
        ecoTheta = 0.0,
        ecoHunger = 0.35,
        ecoPain = 0.0,
        ecoPrevHunger = 0.35,
        ecoPrevPain = 0.0,
        ecoSteps = 0,
        ecoFoods = zeros(N_FOODS * 2),
        ecoFoodTimers = zeros(N_FOODS),
        ecoThreats = zeros(N_THREATS * 2),
        ecoNestX = 0.1,
        ecoNestY = 0.1,
        ecoFoodVisits = 0,
        ecoThreatContacts = 0,
        ecoObs = zeros(OBS_DIM),
        ecoRng = seed
    }
}

val resetEco = { eco0 ->
    var s = eco0.ecoRng
    val rx = randRange(s, 0.2, 0.8)
    val ry = randRange(rx.rngSeed, 0.2, 0.8)
    val rTh = rand01(ry.rngSeed)
    val theta = rTh.rngU * PI2 * 2.0 - PI2
    val rH = randRange(rTh.rngSeed, 0.25, 0.55)
    // Python reset: foods uniform(0.15,0.85); threats uniform(0.2,0.8)
    val foods = fillPoints(N_FOODS, rH.rngSeed, 0.15, 0.85)
    val threats = fillPoints(N_THREATS, foods.ptsSeed, 0.2, 0.8)
    var eco = Eco {
        ecoX = rx.rngU,
        ecoY = ry.rngU,
        ecoTheta = theta,
        ecoHunger = rH.rngU,
        ecoPain = 0.0,
        ecoPrevHunger = rH.rngU,
        ecoPrevPain = 0.0,
        ecoSteps = 0,
        ecoFoods = foods.ptsData,
        ecoFoodTimers = zeros(N_FOODS),
        ecoThreats = threats.ptsData,
        ecoNestX = 0.1,
        ecoNestY = 0.1,
        ecoFoodVisits = 0,
        ecoThreatContacts = 0,
        ecoObs = eco0.ecoObs,
        ecoRng = threats.ptsSeed
    }
    buildObs(eco)
}

val observeEco = { eco ->
    eco.ecoObs
}

/// Override hunger after reset (Python `_rollout(..., hunger_init=…)`).
val withEcoHunger = { eco0, h ->
    buildObs(eco0 with { ecoHunger = h, ecoPrevHunger = h })
}

val withEcoRng = { eco0, s ->
    eco0 with { ecoRng = s }
}

val randomAction = { eco ->
    val r = rand01(eco.ecoRng)
    val a = match {
        r.rngU < 0.25 -> 0
        r.rngU < 0.5 -> 1
        r.rngU < 0.75 -> 2
        _ -> 3
    }
    ActOut { actId = a, actEco = eco with { ecoRng = r.rngSeed } }
}

val stepEco = { eco0, action ->
    stepEcoSeed(eco0, action, eco0.ecoRng)
}

/// Like `stepEco`, but installs `seed` as RNG in the same update (avoids a prior `withEcoRng`).
val stepEcoSeed = { eco0, action, seed ->
    val a = match {
        action < 0 -> 0
        action > 3 -> action % 4
        _ -> action
    }
    var x = eco0.ecoX
    var y = eco0.ecoY
    var theta = eco0.ecoTheta
    var disp = 0.0
    a match {
        0 -> {
            x = eco0.ecoX + MOVE_SPEED * cosF(eco0.ecoTheta)
            y = eco0.ecoY + MOVE_SPEED * sinF(eco0.ecoTheta)
            disp = MOVE_SPEED
        }
        1 -> { theta = eco0.ecoTheta + TURN_ANGLE }
        2 -> { theta = eco0.ecoTheta - TURN_ANGLE }
        _ -> {}
    }
    val pos = clampPos(x, y)
    x = pos.posX
    y = pos.posY
    var hunger = eco0.ecoHunger + HUNGER_RATE
    hunger = match { hunger > 1.5 -> 1.5 _ -> hunger }
    var pain = eco0.ecoPain - PAIN_DECAY
    pain = match { pain < 0.0 -> 0.0 _ -> pain }
    var foodVisits = eco0.ecoFoodVisits
    var threatContacts = eco0.ecoThreatContacts
    var foods = eco0.ecoFoods
    var foodTimers = eco0.ecoFoodTimers
    var rng = 0.0 + seed
    var i = 0
    var ate = 0
    // Python: collide → pop food + start respawn timer (no immediate RNG spawn).
    for i < N_FOODS {
        match {
            ate == 0 -> {
                match {
                    foodTimers.get(i) > 0.0 -> {}
                    _ -> {
                        val fx = foods.get(i * 2)
                        val fy = foods.get(i * 2 + 1)
                        match {
                            hypotF(fx - x, fy - y) < FOOD_R -> {
                                hunger = match { hunger - HUNGER_EAT < 0.0 -> 0.0 _ -> hunger - HUNGER_EAT }
                                foodVisits = foodVisits + 1
                                foodTimers = foodTimers.set(i, 0.0 + FOOD_RESPAWN_DELAY)
                                ate = 1
                            }
                            _ -> {}
                        }
                    }
                }
            }
            _ -> {}
        }
        i = i + 1
    }
    // Tick cooldowns; on expire spawn like Python `_spawn_point(min_dist=0.18)`.
    i = 0
    for i < N_FOODS {
        val t0 = foodTimers.get(i)
        match {
            t0 > 0.0 -> {
                val t1 = t0 - 1.0
                match {
                    t1 <= 0.0 -> {
                        var tries = 0
                        var placed = 0
                        var lastPx = 0.5
                        var lastPy = 0.5
                        for tries < 24 {
                            match {
                                placed == 0 -> {
                                    val rx = randRange(rng, 0.12, 0.88)
                                    val ry = randRange(rx.rngSeed, 0.12, 0.88)
                                    rng = ry.rngSeed
                                    lastPx = rx.rngU
                                    lastPy = ry.rngU
                                    match {
                                        hypotF(lastPx - x, lastPy - y) >= 0.18 -> {
                                            foods = foods.set(i * 2, lastPx)
                                            foods = foods.set(i * 2 + 1, lastPy)
                                            placed = 1
                                        }
                                        _ -> {}
                                    }
                                }
                                _ -> {}
                            }
                            tries = tries + 1
                        }
                        match {
                            placed == 0 -> {
                                val fxb = randRange(rng, 0.15, 0.85)
                                val fyb = randRange(fxb.rngSeed, 0.15, 0.85)
                                rng = fyb.rngSeed
                                foods = foods.set(i * 2, fxb.rngU)
                                foods = foods.set(i * 2 + 1, fyb.rngU)
                            }
                            _ -> {}
                        }
                        foodTimers = foodTimers.set(i, 0.0)
                    }
                    _ -> { foodTimers = foodTimers.set(i, t1) }
                }
            }
            _ -> {}
        }
        i = i + 1
    }
    i = 0
    for i < N_THREATS {
        val tx = eco0.ecoThreats.get(i * 2)
        val ty = eco0.ecoThreats.get(i * 2 + 1)
        match {
            hypotF(tx - x, ty - y) < THREAT_R -> {
                pain = match { pain + PAIN_THREAT > 1.0 -> 1.0 _ -> pain + PAIN_THREAT }
                threatContacts = threatContacts + 1
            }
            _ -> {}
        }
        i = i + 1
    }
    match {
        hypotF(eco0.ecoNestX - x, eco0.ecoNestY - y) < NEST_R -> {
            hunger = match { hunger - 0.02 < 0.0 -> 0.0 _ -> hunger - 0.02 }
        }
        _ -> {}
    }
    val reward = (eco0.ecoPrevHunger - hunger) - PAIN_W * (pain - eco0.ecoPrevPain) - ENERGY_COST
    val steps = eco0.ecoSteps + 1
    val done = match {
        steps >= MAX_STEPS -> 1
        hunger >= 1.4 -> 1
        _ -> 0
    }
    var eco = eco0 with {
        ecoX = x,
        ecoY = y,
        ecoTheta = theta,
        ecoHunger = hunger,
        ecoPain = pain,
        ecoPrevHunger = hunger,
        ecoPrevPain = pain,
        ecoSteps = steps,
        ecoFoods = foods,
        ecoFoodTimers = foodTimers,
        ecoFoodVisits = foodVisits,
        ecoThreatContacts = threatContacts,
        ecoRng = rng
    }
    eco = buildObs(eco)
    EcoStep { stepEco = eco, stepReward = reward, stepDone = done, stepDisp = disp }
}
